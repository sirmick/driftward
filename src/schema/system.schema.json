          "minimum": 0,
          "maximum": 7200,
          "default": 900
        },
        "starPeriod": {
          "description": "As period, for the stations that circle a star (three of its radii out); 0, the default, holds them still, since a ring round the star sweeps through every planet's neighbourhood.",
