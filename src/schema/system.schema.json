{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftward.game/schema/system.schema.json",
  "title": "Driftward star system",
  "description": "One star system: its star, bodies and ports. The contract an LLM authors against and the validator that clamps what it writes (src/schema.js). Distances are metres; the star sits at the origin; angles are degrees counter-clockwise from +x. Bodies hold still in M1.",
  "type": "object",
  "required": [
    "id",
    "name",
    "owner",
    "ring",
    "star",
    "bodies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "owner": {
      "description": "The faction that holds the system (the Book's appendix, by role).",
      "enum": [
        "federation",
        "prism",
        "ironhulls",
        "blackhulls",
        "freeflag",
        "bloom",
        "glass",
        "shadow",
        "none"
      ]
    },
    "ring": {
      "description": "Inner rings are prosperous, the outer ring poor and lawless.",
      "enum": [
        "inner",
        "middle",
        "outer"
      ]
    },
    "region": {
      "description": "The region the system belongs to: notes on it and its neighbours are src/lore/regions/<region>.md, which the lore tool sends with the facts.",
      "type": "string",
      "pattern": "^[a-z0-9-]*$",
      "maxLength": 40,
      "default": ""
    },
    "description": {
      "type": "string",
      "maxLength": 800,
      "default": ""
    },
    "star": {
      "type": "object",
      "required": [
        "name",
        "class"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "class": {
          "enum": [
            "red-dwarf",
            "orange",
            "yellow",
            "white",
            "blue-giant"
          ],
          "default": "yellow"
        },
        "radius": {
          "type": "number",
          "minimum": 800,
          "maximum": 6000,
          "default": 2400
        },
        "gravity": {
          "description": "Well strength at the surface; 40 is a full-strength well.",
          "type": "number",
          "minimum": 0,
          "maximum": 80,
          "default": 55
        }
      }
    },
    "start": {
      "description": "The id of the port body a new game starts landed at.",
      "type": "string",
      "default": ""
    },
    "bodies": {
      "type": "array",
      "description": "Planets, moons and stations; the star is not one of them. At most 7: the game's core holds 8 bodies with the star.",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "orbit",
          "radius"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "enum": [
              "planet",
              "moon",
              "station"
            ]
          },
          "parent": {
            "description": "Id of the body a moon or station orbits; omit to orbit the star.",
            "type": "string",
            "default": ""
          },
          "orbit": {
            "type": "object",
            "required": [
              "radius",
              "angle"
            ],
            "properties": {
              "radius": {
                "type": "number",
                "minimum": 1500,
                "maximum": 60000
              },
              "angle": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              }
            }
          },
          "radius": {
            "description": "Planets and moons: the body. Stations: the docking zone's reach.",
            "type": "number",
            "minimum": 150,
            "maximum": 4000
          },
          "gravity": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 30
          },
          "look": {
            "description": "How a planet or moon is drawn (the flight planet shader, src/shaders.js PLANET_FS) and what orbits it (core/src/orbit.rs). Every field has a default, so an omitted look is a plain grey rock.",
            "type": "object",
            "default": {},
            "properties": {
              "surface": {
                "enum": [
                  "terran",
                  "giant",
                  "rock"
                ],
                "default": "rock",
                "description": "terran: seas, land in biomes, clouds; giant: banded gas, storms; rock: craters, no water."
              },
              "palette": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "minItems": 3,
                "maxItems": 3,
                "default": [
                  "#5e5953",
                  "#8a8178",
                  "#c9c0b4"
                ],
                "description": "Three colours, used by surface. terran: seas, lowlands (the green of its vegetation), highlands (dry ground and deserts). giant: two band colours, then the pale zones and storms. rock: crater floors and plains, ground, rims and ridges."
              },
              "atmosphere": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "default": "#9fb4c8",
                "description": "The colour the air scatters: the limb and the day-side haze take it, and the light that gets through (dusk on the terminator) takes its complement, as a blue sky gives an orange dusk. How much air there is is `air`."
              },
              "air": {
                "description": "How much atmosphere: 0 airless, 1 Earth-like, up to 2 thick haze. Scatters the atmosphere colour, so the light that gets through (sunsets, the terminator) takes its complement.",
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "default": 0.6
              },
              "lightning": {
                "description": "How stormy: 0 none, 1 a world full of lightning (in its clouds, or a giant's belts).",
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0
              },
              "debris": {
                "description": "Scales the orbiting debris the world wears (rocky worlds wear the most).",
                "type": "number",
                "minimum": 0,
                "maximum": 3,
                "default": 1
              },
              "orbitTraffic": {
                "description": "Scales the small orbiting traffic (beacons and pods) a world with a port wears; its count follows the port's population.",
                "type": "number",
                "minimum": 0,
                "maximum": 3,
                "default": 1
              },
              "cityLights": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0,
                "description": "Settlement lights on the night side of temperate coasts and lowlands (terran only): 0 none, 1 a busy world."
              },
              "seed": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 1,
                "description": "Picks the world's continents, craters, bands and storms; the same seed draws the same world."
              },
              "rings": {
                "description": "A ring system in the world's equator; the world spins about the same pole. Density 0 (the default) is no rings. Radii are in the world's radii, measured from its centre; outer must be at least 0.1 beyond inner.",
                "type": "object",
                "default": {},
                "properties": {
                  "density": {
                    "description": "How opaque the rings are: 0 none, 1 nearly solid.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0
                  },
                  "inner": {
                    "description": "Inner edge, in world radii.",
                    "type": "number",
                    "minimum": 1.1,
                    "maximum": 2.6,
                    "default": 1.4
                  },
                  "outer": {
                    "description": "Outer edge, in world radii.",
                    "type": "number",
                    "minimum": 1.3,
                    "maximum": 3.6,
                    "default": 2.2
                  },
                  "colours": {
                    "description": "The rings' colour at the inner edge, then the outer; ringlets mix between them.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      "#dfe9f2",
                      "#94a8bc"
                    ]
                  },
                  "tilt": {
                    "description": "How open the rings are to the view, in degrees between the pole and the line of sight: 0 face-on (round), 90 edge-on (a line). 50 to 80 reads best.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 88,
                    "default": 65
                  },
                  "angle": {
                    "description": "Which way the pole leans on screen, in degrees: 0 up, 90 left, -90 right.",
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "default": 0
                  }
                }
              }
            }
          },
          "station": {
            "description": "How a station is built: a catalog archetype in an owning brand's style. Used only on a station body, which gets the defaults if it has none.",
            "type": "object",
            "properties": {
              "archetype": {
                "enum": [
                  "ring",
                  "port",
                  "forge",
                  "refinery",
                  "shipyard",
                  "relay"
                ],
                "default": "port"
              },
              "brand": {
                "description": "The faction whose style the station is built in (catalog factions; the Book's appendix).",
                "enum": [
                  "federation",
                  "prism",
                  "ironhulls",
                  "bloom"
                ],
                "default": "ironhulls"
              },
              "seed": {
                "type": "string",
                "maxLength": 40,
                "default": "",
                "description": "Picks the station's layout within its archetype; empty uses the body's id, so no two stations share one."
              }
            }
          },
          "environs": {
            "description": "Environmental stations round this world: forges, container ports, habitats and the like, each a station you can see but not land at, with its own traffic (traffic.json's environs: which ships fly to and from each archetype, how often). Each entry is a type, its owner and how many. A system holds at most 24 in all.",
            "type": "array",
            "maxItems": 4,
            "default": [],
            "items": {
              "type": "object",
              "required": [
                "archetype"
              ],
              "properties": {
                "archetype": {
                  "enum": [
                    "ring",
                    "port",
                    "forge",
                    "refinery",
                    "shipyard",
                    "relay"
                  ],
                  "default": "port",
                  "description": "The station type (a catalog archetype); its traffic comes from traffic.json's environs."
                },
                "brand": {
                  "enum": [
                    "federation",
                    "prism",
                    "ironhulls",
                    "bloom"
                  ],
                  "default": "ironhulls",
                  "description": "The faction that built and runs it: its look, and the lines its traffic flies where traffic.json says own.<line>."
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "default": 1,
                  "description": "How many of this type round the world; sizes and places vary."
                }
              }
            }
          },
          "port": {
            "description": "Present if the body has a port the player can land at.",
            "type": "object",
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "role": {
                "description": "The facility's economic role (the Book's Facilities table).",
                "enum": [
                  "mining",
                  "ice",
                  "gas",
                  "refinery",
                  "forge",
                  "agri",
                  "habitat",
                  "container-port",
                  "shipyard",
                  "relay",
                  "military",
                  "research",
                  "haven"
                ]
              },
              "population": {
                "enum": [
                  "outpost",
                  "colony",
                  "town",
                  "world"
                ],
                "default": "colony"
              },
              "description": {
                "type": "string",
                "maxLength": 1200,
                "default": ""
              },
              "services": {
                "type": "array",
                "items": {
                  "enum": [
                    "market",
                    "missions",
                    "bar",
                    "refuel",
                    "repair",
                    "outfitter",
                    "shipyard"
                  ]
                },
                "default": [
                  "market",
                  "missions",
                  "bar",
                  "refuel",
                  "repair"
                ]
              }
            }
          }
        }
      }
    },
    "belts": {
      "type": "array",
      "description": "Asteroid belts and fields: scenery in M1 (drawn with the lab's rocks, src/rocks.js), listed in the location list in orbital order and flown to by the autopilot; mining targets to come (M3). Ships fly through them. At most 4.",
      "default": [],
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "orbit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "description": "A belt is a ring of rocks round its parent; a field is a cluster at one point of an orbit.",
            "enum": [
              "belt",
              "field"
            ],
            "default": "belt"
          },
          "parent": {
            "description": "Id of the body it circles; omit to circle the star.",
            "type": "string",
            "default": ""
          },
          "orbit": {
            "type": "object",
            "required": [
              "radius"
            ],
            "properties": {
              "radius": {
                "description": "A belt: the middle of its ring. A field: how far its centre is from the parent.",
                "type": "number",
                "minimum": 1500,
                "maximum": 60000
              },
              "angle": {
                "description": "A field: where its centre is on the orbit. A belt ignores it.",
                "type": "number",
                "minimum": 0,
                "maximum": 360,
                "default": 0
              }
            }
          },
          "width": {
            "description": "A belt: the ring's width. A field: its diameter. Metres.",
            "type": "number",
            "minimum": 300,
            "maximum": 12000,
            "default": 2400
          },
          "density": {
            "description": "How crowded: 1 is a rock every 150 m or so, 0.1 a scattering.",
            "type": "number",
            "minimum": 0.05,
            "maximum": 1,
            "default": 0.5
          },
          "rocks": {
            "description": "What the rocks are made of (the lab's compositions), the first commonest.",
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "enum": [
                "carbon",
                "silicate",
                "metal",
                "basalt",
                "iron",
                "olivine",
                "icy",
                "crystal",
                "gold",
                "cobalt"
              ]
            },
            "default": [
              "silicate",
              "carbon"
            ]
          },
          "seed": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "default": 1
          }
        }
      }
    },
    "traffic": {
      "description": "Ambient traffic (the Book's Traffic chapter): local ships between the ports, through traffic in from and out to the jump zones, and ships loitering round their ports. Which hulls fly is the mix; the core decides when and where.",
      "type": "object",
      "default": {},
      "properties": {
        "ships": {
          "description": "Local and through ships in flight at steady state.",
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 30
        },
        "throughShare": {
          "description": "Through traffic's share of the ships.",
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.45
        },
        "jumpRadius": {
          "description": "Distance of the four jump zones (north, east, south, west) from the star, metres.",
          "type": "number",
          "minimum": 10000,
          "maximum": 200000,
          "default": 45000
        },
        "local": {
          "description": "Who flies between the ports.",
          "type": "array",
          "maxItems": 12,
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "line",
              "share",
              "classes"
            ],
            "properties": {
              "line": {
                "description": "A catalog faction line, faction.line.",
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
                "maxLength": 60
              },
              "share": {
                "description": "The entry's share of its stream (shares are normalised).",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "classes": {
                "description": "Weights by size class (catalog sizes): which classes the entry flies, and how often. Leave a class out to never fly it.",
                "type": "object",
                "default": {},
                "properties": {
                  "c1": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c3": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c4": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c5": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  }
                }
              }
            }
          }
        },
        "through": {
          "description": "Who arrives and leaves by the jump zones.",
          "type": "array",
          "maxItems": 12,
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "line",
              "share",
              "classes"
            ],
            "properties": {
              "line": {
                "description": "A catalog faction line, faction.line.",
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
                "maxLength": 60
              },
              "share": {
                "description": "The entry's share of its stream (shares are normalised).",
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "classes": {
                "description": "Weights by size class (catalog sizes): which classes the entry flies, and how often. Leave a class out to never fly it.",
                "type": "object",
                "default": {},
                "properties": {
                  "c1": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c3": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c4": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c5": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  }
                }
              }
            }
          }
        },
        "loiter": {
          "description": "Ships that launch, circle their port and land there again.",
          "type": "array",
          "maxItems": 12,
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "port",
              "line",
              "count",
              "classes"
            ],
            "properties": {
              "port": {
                "description": "The body id of the port they loiter round.",
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "maxLength": 40
              },
              "line": {
                "description": "A catalog faction line, faction.line.",
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
                "maxLength": 60
              },
              "count": {
                "description": "Ships kept loitering at a time, on average.",
                "type": "number",
                "minimum": 0,
                "maximum": 8
              },
              "classes": {
                "description": "Weights by size class (catalog sizes): which classes the entry flies, and how often. Leave a class out to never fly it.",
                "type": "object",
                "default": {},
                "properties": {
                  "c1": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c2": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c3": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c4": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  },
                  "c5": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100,
                    "default": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
