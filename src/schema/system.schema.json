{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftward.game/schema/system.schema.json",
  "title": "Driftward star system",
  "description": "One star system: its star, bodies and ports. The contract an LLM authors against and the validator that clamps what it writes (src/schema.js). Distances are metres; the star sits at the origin; angles are degrees counter-clockwise from +x. Planets, moons and the stars hold still; stations circle their parent (stations).",
  "type": "object",
  "required": [
    "id",
    "name",
    "owner",
    "ring",
    "star",
    "bodies"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 40
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "owner": {
      "description": "The faction that holds the system (the Book's appendix, by role): one vocabulary with the universe index (src/galaxy/universe.json), whose owner a system file must match. independent: a world no faction holds; none: unclaimed, nobody's.",
      "enum": [
        "federation",
        "prism",
        "ironhulls",
        "blackhulls",
        "freeflag",
        "independent",
        "bloom",
        "glass",
        "shadow",
        "none"
      ]
    },
    "ring": {
      "description": "Inner rings are prosperous, the outer ring poor and lawless.",
      "enum": [
        "inner",
        "middle",
        "outer"
      ]
    },
    "region": {
      "description": "The region the system belongs to: notes on it and its neighbours are src/lore/regions/<region>.md, which the lore tool sends with the facts.",
      "type": "string",
      "pattern": "^[a-z0-9-]*$",
      "maxLength": 40,
      "default": ""
    },
    "description": {
      "type": "string",
      "maxLength": 800,
      "default": ""
    },
    "star": {
      "type": "object",
      "required": [
        "name",
        "class"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "class": {
          "description": "One of the twelve classes. Pulsars, black holes and quasars are exotics: each has a hazard zone round it where radiation wears a hull down, and traffic and the autopilot keep clear of it.",
          "enum": [
            "yellow",
            "orange",
            "red-dwarf",
            "brown-dwarf",
            "red-giant",
            "white",
            "blue-giant",
            "wolf-rayet",
            "white-dwarf",
            "pulsar",
            "black-hole",
            "quasar"
          ],
          "default": "yellow"
        },
        "radius": {
          "description": "The star's radius, metres (a black hole's: its horizon). Leave it out for the class's (src/stars.js).",
          "type": "number",
          "minimum": 150,
          "maximum": 8000
        },
        "gravity": {
          "description": "Well strength at the surface; 40 is a full-strength well. Leave it out for the class's.",
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "hazard": {
          "description": "The hazard zone's radius, metres (exotics only; 0 for none). Leave it out for the class's.",
          "type": "number",
          "minimum": 0,
          "maximum": 30000
        },
        "seed": {
          "description": "Varies the class's look a little (temperature, spots, tilts).",
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 1
        },
        "look": {
          "description": "How the star is drawn: any of its class's look values, overridden (src/stars.js STAR_CLASSES has each class's; the debug screen's Suns tab shows them). Leave it out for the class's own look. Values a class doesn't use (a black hole's temperature) are ignored.",
          "type": "object",
          "default": {},
          "properties": {
            "temp": {
              "description": "Surface temperature, kelvin: sets the colour (stars, pulsars).",
              "type": "number",
              "minimum": 1000,
              "maximum": 40000
            },
            "bright": {
              "description": "Brightness of the disc (stars, pulsars).",
              "type": "number",
              "minimum": 0.5,
              "maximum": 16
            },
            "gran": {
              "description": "Granulation: the boiling cells on the surface (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "cell": {
              "description": "Size of the granulation cells (bigger is finer) (stars).",
              "type": "number",
              "minimum": 1.5,
              "maximum": 10
            },
            "spots": {
              "description": "Starspots (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "corona": {
              "description": "Corona: the glow round the disc (stars, pulsars).",
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "streamers": {
              "description": "Streamers in the corona (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "prom": {
              "description": "Prominences on the limb (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1.2
            },
            "limb": {
              "description": "Limb darkening (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bands": {
              "description": "Bands across the disc (brown dwarfs) (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "shell": {
              "description": "An ejecta shell round the star (Wolf-Rayet) (stars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            },
            "beamTilt": {
              "description": "A pulsar's beam tilt from its spin axis, degrees (pulsars).",
              "type": "number",
              "minimum": 5,
              "maximum": 90
            },
            "beamRate": {
              "description": "A pulsar's spin, turns a second (pulsars).",
              "type": "number",
              "minimum": 0.1,
              "maximum": 6
            },
            "beamW": {
              "description": "A pulsar's beam width (pulsars).",
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            },
            "nebula": {
              "description": "A pulsar's wind nebula (pulsars).",
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            },
            "diskTilt": {
              "description": "A black hole's accretion disk tilt from face-on, degrees (black holes).",
              "type": "number",
              "minimum": 0,
              "maximum": 89
            },
            "diskAngle": {
              "description": "The disk's angle on the sky, degrees (black holes).",
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "diskIn": {
              "description": "The disk's inner edge, horizon radii (black holes).",
              "type": "number",
              "minimum": 1.6,
              "maximum": 6
            },
            "diskOut": {
              "description": "The disk's outer edge, horizon radii (black holes).",
              "type": "number",
              "minimum": 5,
              "maximum": 18
            },
            "diskTemp": {
              "description": "The disk's temperature, kelvin (black holes).",
              "type": "number",
              "minimum": 2500,
              "maximum": 30000
            },
            "diskB": {
              "description": "The disk's brightness (black holes).",
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "jets": {
              "description": "Jets from the poles (quasars) (black holes).",
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "flare": {
              "description": "Lens flare strength (stars, pulsars, black holes).",
              "type": "number",
              "minimum": 0,
              "maximum": 2.5
            },
            "spikes": {
              "description": "Diffraction spikes (stars, pulsars, black holes).",
              "type": "number",
              "minimum": 4,
              "maximum": 10
            },
            "anam": {
              "description": "Anamorphic streak (stars, pulsars, black holes).",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "companion": {
          "description": "A binary's second star (id \"companion\": a planet orbits it with parent \"companion\"). Both stars hold still, as every body but a moving station does.",
          "type": "object",
          "required": [
            "name",
            "class",
            "orbit"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "class": {
              "description": "One of the twelve classes. Pulsars, black holes and quasars are exotics: each has a hazard zone round it where radiation wears a hull down, and traffic and the autopilot keep clear of it.",
              "enum": [
                "yellow",
                "orange",
                "red-dwarf",
                "brown-dwarf",
                "red-giant",
                "white",
                "blue-giant",
                "wolf-rayet",
                "white-dwarf",
                "pulsar",
                "black-hole",
                "quasar"
              ],
              "default": "yellow"
            },
            "radius": {
              "description": "The star's radius, metres (a black hole's: its horizon). Leave it out for the class's (src/stars.js).",
              "type": "number",
              "minimum": 150,
              "maximum": 8000
            },
            "gravity": {
              "description": "Well strength at the surface; 40 is a full-strength well. Leave it out for the class's.",
              "type": "number",
              "minimum": 0,
              "maximum": 120
            },
            "hazard": {
              "description": "The hazard zone's radius, metres (exotics only; 0 for none). Leave it out for the class's.",
              "type": "number",
              "minimum": 0,
              "maximum": 30000
            },
            "seed": {
              "description": "Varies the class's look a little (temperature, spots, tilts).",
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "default": 1
            },
            "look": {
              "description": "How the star is drawn: any of its class's look values, overridden (src/stars.js STAR_CLASSES has each class's; the debug screen's Suns tab shows them). Leave it out for the class's own look. Values a class doesn't use (a black hole's temperature) are ignored.",
              "type": "object",
              "default": {},
              "properties": {
                "temp": {
                  "description": "Surface temperature, kelvin: sets the colour (stars, pulsars).",
                  "type": "number",
                  "minimum": 1000,
                  "maximum": 40000
                },
                "bright": {
                  "description": "Brightness of the disc (stars, pulsars).",
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 16
                },
                "gran": {
                  "description": "Granulation: the boiling cells on the surface (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "cell": {
                  "description": "Size of the granulation cells (bigger is finer) (stars).",
                  "type": "number",
                  "minimum": 1.5,
                  "maximum": 10
                },
                "spots": {
                  "description": "Starspots (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "corona": {
                  "description": "Corona: the glow round the disc (stars, pulsars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "streamers": {
                  "description": "Streamers in the corona (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "prom": {
                  "description": "Prominences on the limb (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.2
                },
                "limb": {
                  "description": "Limb darkening (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bands": {
                  "description": "Bands across the disc (brown dwarfs) (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "shell": {
                  "description": "An ejecta shell round the star (Wolf-Rayet) (stars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.5
                },
                "beamTilt": {
                  "description": "A pulsar's beam tilt from its spin axis, degrees (pulsars).",
                  "type": "number",
                  "minimum": 5,
                  "maximum": 90
                },
                "beamRate": {
                  "description": "A pulsar's spin, turns a second (pulsars).",
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 6
                },
                "beamW": {
                  "description": "A pulsar's beam width (pulsars).",
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1
                },
                "nebula": {
                  "description": "A pulsar's wind nebula (pulsars).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.5
                },
                "diskTilt": {
                  "description": "A black hole's accretion disk tilt from face-on, degrees (black holes).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 89
                },
                "diskAngle": {
                  "description": "The disk's angle on the sky, degrees (black holes).",
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "diskIn": {
                  "description": "The disk's inner edge, horizon radii (black holes).",
                  "type": "number",
                  "minimum": 1.6,
                  "maximum": 6
                },
                "diskOut": {
                  "description": "The disk's outer edge, horizon radii (black holes).",
                  "type": "number",
                  "minimum": 5,
                  "maximum": 18
                },
                "diskTemp": {
                  "description": "The disk's temperature, kelvin (black holes).",
                  "type": "number",
                  "minimum": 2500,
                  "maximum": 30000
                },
                "diskB": {
                  "description": "The disk's brightness (black holes).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 4
                },
                "jets": {
                  "description": "Jets from the poles (quasars) (black holes).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "flare": {
                  "description": "Lens flare strength (stars, pulsars, black holes).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2.5
                },
                "spikes": {
                  "description": "Diffraction spikes (stars, pulsars, black holes).",
                  "type": "number",
                  "minimum": 4,
                  "maximum": 10
                },
                "anam": {
                  "description": "Anamorphic streak (stars, pulsars, black holes).",
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "orbit": {
              "description": "Where the companion is: distance from the first star, which sits at the origin, and the angle.",
              "type": "object",
              "required": [
                "radius",
                "angle"
              ],
              "properties": {
                "radius": {
                  "type": "number",
                  "minimum": 3000,
                  "maximum": 40000
                },
                "angle": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                }
              }
            }
          }
        }
      },
      "description": "The system's star, at the origin; with a companion, a binary."
    },
    "start": {
      "description": "The id of the port body a new game starts landed at.",
      "type": "string",
      "default": ""
    },
    "bodies": {
      "type": "array",
      "description": "Planets, moons and stations; the stars are not among them. At most 7.",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "orbit",
          "radius"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "kind": {
            "enum": [
              "planet",
              "moon",
              "station"
            ]
          },
          "parent": {
            "description": "Id of the body a moon or station orbits; omit to orbit the star (\"companion\" for a binary's second star).",
            "type": "string",
            "default": ""
          },
          "orbit": {
            "type": "object",
            "required": [
              "radius",
              "angle"
            ],
            "properties": {
              "radius": {
                "type": "number",
                "minimum": 1500,
                "maximum": 60000
              },
              "angle": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              }
            }
          },
          "radius": {
            "description": "Planets and moons: the body. Stations: the docking zone's reach.",
            "type": "number",
            "minimum": 150,
            "maximum": 4000
          },
          "gravity": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 30
          },
          "look": {
            "description": "How a planet or moon is drawn (the flight planet shader, src/shaders.js PLANET_FS) and what orbits it (core/src/orbit.rs). Every field has a default, so an omitted look is a plain grey rock.",
            "type": "object",
            "default": {},
            "properties": {
              "surface": {
                "enum": [
                  "terran",
                  "giant",
                  "rock"
                ],
                "default": "rock",
                "description": "terran: seas, land in biomes, clouds; giant: banded gas, storms; rock: craters, no water."
              },
              "palette": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "minItems": 3,
                "maxItems": 3,
                "default": [
                  "#5e5953",
                  "#8a8178",
                  "#c9c0b4"
                ],
                "description": "Three colours, used by surface. terran: seas, lowlands (the green of its vegetation), highlands (dry ground and deserts). giant: two band colours, then the pale zones and storms. rock: crater floors and plains, ground, rims and ridges."
              },
              "atmosphere": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$",
                "default": "#9fb4c8",
                "description": "The colour the air scatters: the limb and the day-side haze take it, and the light that gets through (dusk on the terminator) takes its complement, as a blue sky gives an orange dusk. How much air there is is `air`."
              },
              "air": {
                "description": "How much atmosphere: 0 airless, 1 Earth-like, up to 2 thick haze. Scatters the atmosphere colour, so the light that gets through (sunsets, the terminator) takes its complement.",
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "default": 0.6
              },
              "lightning": {
                "description": "How stormy: 0 none, 1 a world full of lightning (in its clouds, or a giant's belts).",
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0
              },
              "debris": {
                "description": "Scales the orbiting debris the world wears (rocky worlds wear the most).",
                "type": "number",
                "minimum": 0,
                "maximum": 3,
                "default": 1
              },
              "orbitTraffic": {
                "description": "Scales the small orbiting traffic (beacons and pods) a world with a port wears; its count follows the port's population.",
                "type": "number",
                "minimum": 0,
                "maximum": 3,
                "default": 1
              },
              "cityLights": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0,
                "description": "Settlement lights on the night side of temperate coasts and lowlands (terran only): 0 none, 1 a busy world."
              },
              "seed": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "default": 1,
                "description": "Picks the world's continents, craters, bands and storms; the same seed draws the same world."
              },
              "rings": {
                "description": "A ring system in the world's equator; the world spins about the same pole. Density 0 (the default) is no rings. Radii are in the world's radii, measured from its centre; outer must be at least 0.1 beyond inner.",
                "type": "object",
                "default": {},
                "properties": {
                  "density": {
                    "description": "How opaque the rings are: 0 none, 1 nearly solid.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0
                  },
                  "inner": {
                    "description": "Inner edge, in world radii.",
                    "type": "number",
                    "minimum": 1.1,
                    "maximum": 2.6,
                    "default": 1.4
                  },
                  "outer": {
                    "description": "Outer edge, in world radii.",
                    "type": "number",
                    "minimum": 1.3,
                    "maximum": 3.6,
                    "default": 2.2
                  },
                  "colours": {
                    "description": "The rings' colour at the inner edge, then the outer; ringlets mix between them.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "minItems": 2,
                    "maxItems": 2,
                    "default": [
                      "#dfe9f2",
                      "#94a8bc"
                    ]
                  },
                  "tilt": {
                    "description": "How open the rings are to the view, in degrees between the pole and the line of sight: 0 face-on (round), 90 edge-on (a line). 50 to 80 reads best.",
                    "type": "number",
                    "minimum": 0,
                    "maximum": 88,
                    "default": 65
                  },
                  "angle": {
                    "description": "Which way the pole leans on screen, in degrees: 0 up, 90 left, -90 right.",
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "default": 0
                  }
                }
              }
            }
          },
          "station": {
            "description": "How a station is built: a catalog archetype in an owning brand's style. Used only on a station body, which gets the defaults if it has none.",
            "type": "object",
            "properties": {
              "archetype": {
                "enum": [
                  "ring",
                  "port",
                  "forge",
                  "refinery",
                  "shipyard",
                  "relay"
                ],
                "default": "port"
              },
              "brand": {
                "description": "The faction whose style the station is built in (catalog factions; the Book's appendix).",
                "enum": [
                  "federation",
                  "prism",
                  "ironhulls",
                  "bloom"
                ],
                "default": "ironhulls"
              },
              "seed": {
                "type": "string",
                "maxLength": 40,
                "default": "",
                "description": "Picks the station's layout within its archetype; empty uses the body's id, so no two stations share one."
              }
            }
          },
          "environs": {
            "description": "Environmental stations round this world: forges, container ports, habitats and the like, each a station you can see but not land at, with its own traffic (traffic.json's environs: which ships fly to and from each archetype, how often). Each entry is a type, its owner and how many. A system holds at most 24 in all.",
            "type": "array",
            "maxItems": 4,
            "default": [],
            "items": {
              "type": "object",
              "required": [
                "archetype"
              ],
              "properties": {
                "archetype": {
                  "enum": [
                    "ring",
                    "port",
                    "forge",
                    "refinery",
                    "shipyard",
                    "relay"
                  ],
                  "default": "port",
                  "description": "The station type (a catalog archetype); its traffic comes from traffic.json's environs."
                },
                "brand": {
                  "enum": [
                    "federation",
                    "prism",
                    "ironhulls",
                    "bloom"
                  ],
                  "default": "ironhulls",
                  "description": "The faction that built and runs it: its look, and the lines its traffic flies where traffic.json says own.<line>."
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "default": 1,
                  "description": "How many of this type round the world; sizes and places vary."
                }
              }
            }
          },
          "port": {
            "description": "Present if the body has a port the player can land at.",
            "type": "object",
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "role": {
                "description": "The facility's economic role (the Book's Facilities table).",
                "enum": [
                  "mining",
                  "ice",
                  "gas",
                  "refinery",
                  "forge",
                  "agri",
                  "habitat",
                  "container-port",
                  "shipyard",
                  "relay",
                  "military",
                  "research",
                  "haven"
                ]
              },
              "population": {
                "enum": [
                  "outwatch",
                  "outpost",
                  "colony",
                  "town",
                  "world"
                ],
                "default": "colony",
                "description": "The port's settlement tier, from the fewest people to the most (tools/worlds.py's tiers: an outwatch is a few thousand at most, an outpost tens of thousands, a colony up to a million, a town up to a hundred million, a world more). The universe index gives the system's tier, from all its people: no port's may exceed it."
              },
              "builtworld": {
                "type": "boolean",
                "default": false,
                "description": "A Builtworld: a whole planet built over into one city, about ten billion people (six in human space; the universe index marks the system). Only on a world-tier port."
