{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftward.game/schema/universe.schema.json",
  "title": "Driftward universe index",
  "description": "The universe the game loads at start (src/galaxy/universe.json, made by tools/universe.py from src/galaxy/ and src/lore/regions/): the factions, the regions, every system once by star id, and the lanes. A flyable system's layout is its system file (system.schema.json), named by `file` and loaded on demand. Owners, rings, star classes, port roles and population tiers are the system schema's vocabulary; tools/validate.js checks every system file against its entry here.",
  "type": "object",
  "required": [
    "made",
    "factions",
    "regions",
    "systems",
    "lanes"
  ],
  "properties": {
    "source": {
      "type": "string",
      "maxLength": 200,
      "default": ""
    },
    "made": {
      "description": "The galaxy's hash (tools/universe.py galaxy_hash) and the hash each of worlds.json and every region's stories in stories.json was made from; they must all match (tools/validate.js), or a galaxy rerun has left them stale.",
      "type": "object",
      "required": [
        "galaxy"
      ],
      "properties": {
        "galaxy": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "worlds": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "stories": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "default": {}
        }
      }
    },
    "factions": {
      "description": "Who can hold a system, by the system schema's owner key (all but none): name and map colour (linear RGB); alien for the Bloom, the Glass and the Shadow.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "colour"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "colour": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "alien": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "regions": {
      "description": "The named regions, by id (each system's region): the name, the region's trade where it has one (tools/worlds.py: what it exports and must import, and its people), the summary it was told (tools/stories.py, with the model and date), and the hand-written notes (src/lore/regions/<id>.md, canon for its stories and lore).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "trade": {
            "type": "object",
            "required": [
              "exports",
              "imports",
              "population"
            ],
            "properties": {
              "exports": {
                "type": "array",
                "items": {
                  "enum": [
                    "food",
                    "water",
                    "ore",
                    "metals",
                    "fuel",
                    "chemicals",
                    "alloys",
                    "components",
                    "goods",
                    "medicine"
                  ]
                }
              },
              "imports": {
                "type": "array",
                "items": {
                  "enum": [
                    "food",
                    "water",
                    "ore",
                    "metals",
                    "fuel",
                    "chemicals",
                    "alloys",
                    "components",
                    "goods",
                    "medicine"
                  ]
                }
              },
              "population": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000.0
              }
            }
          },
          "summary": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          },
          "told": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 40000
          }
        }
      }
    },
    "systems": {
      "description": "Every system on the map, once. Charted ones are real stars (ids are src/galaxy/stars.json ids); the deep Drift's are generated (ids from 9,000,000).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "group",
          "status",
          "region",
          "owner",
          "pos",
          "class"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999999
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "catalog": {
            "type": "string",
            "maxLength": 40,
            "description": "The star's catalogue name, where the game calls the system something else."
          },
          "group": {
            "enum": [
              "human",
              "drift",
              "bloom",
              "glass",
              "shadow"
            ],
            "description": "Whose space it is: human space, the Drift beyond it, or an alien power's."
          },
          "status": {
            "enum": [
              "inhabited",
              "dead",
              "living",
              "glass",
              "emptied",
              "held"
            ],
            "description": "inhabited: people live there; dead: nobody does (a dead star, an abandoned world or never settled); living: the Bloom's; glass: the Glass's; emptied: the Shadow took its people; held: the Shadow holds it."
          },
          "region": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 40
          },
          "owner": {
            "enum": [
              "federation",
              "prism",
              "ironhulls",
              "blackhulls",
              "freeflag",
              "independent",
              "bloom",
              "glass",
              "shadow",
              "none"
            ],
            "description": "Who holds it, in the system schema's owner vocabulary: a faction, an alien power, or none."
          },
          "ring": {
            "enum": [
              "inner",
              "middle",
              "outer"
            ],
            "description": "Human space's ring (inner rings prosperous, the outer poor and lawless); absent in the Drift and alien space."
          },
          "pos": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -200,
              "maximum": 200
            },
            "description": "Light years, galactic coordinates, Sol at the origin."
          },
          "class": {
            "enum": [
              "yellow",
              "orange",
              "red-dwarf",
              "brown-dwarf",
              "red-giant",
              "white",
              "blue-giant",
              "wolf-rayet",
              "white-dwarf",
              "pulsar",
              "black-hole",
              "quasar"
            ]
          },
          "absmag": {
            "type": "number",
            "minimum": -15,
            "maximum": 25
          },
          "generated": {
            "type": "boolean",
            "default": false,
            "description": "A deep Drift star, grown past the catalogue (tools/galaxy.py)."
          },
          "jumps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "Lanes from Sol."
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99,
            "description": "The Drift's depth: jumps out from human space."
          },
          "sector": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "settled": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2600
          },
          "charted": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2600
          },
          "seen": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2600
          },
          "emptied": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2600
          },
          "lost": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2600
          },
          "gateway": {
            "type": "boolean",
            "default": false,
            "description": "A lane from it into the open Drift."
          },
          "exclave": {
            "type": "string",
            "maxLength": 40,
            "description": "Cut off from its owner's main territory, and what it is (a navy base, a rebel cell)."
          },
          "hazard": {
            "type": "boolean",
            "default": false
          },
          "front": {
            "type": "boolean",
            "default": false,
            "description": "On the Shadow front."
          },
          "provisional": {
            "type": "boolean",
            "default": false,
            "description": "Its name is a placeholder."
          },
          "world": {
            "description": "Its people and economy (tools/worlds.py): settled systems only.",
            "type": "object",
            "required": [
              "population",
              "tier",
              "roles"
            ],
            "properties": {
              "population": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000000.0
              },
              "tier": {
                "enum": [
                  "outwatch",
                  "outpost",
                  "colony",
                  "complex",
                  "world"
                ],
                "description": "The settlement tier of all its people (the system schema's port population tiers): no port's may be higher."
              },
              "builtworld": {
                "type": "boolean",
                "default": false,
                "description": "One of its planets is a Builtworld (a world-tier port with builtworld)."
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "mining",
                    "ice",
                    "gas",
                    "refinery",
                    "forge",
                    "agri",
                    "habitat",
                    "container-port",
                    "shipyard",
                    "relay",
                    "military",
                    "research",
                    "haven"
                  ]
                },
                "description": "Its ports' roles: a system file's ports hold exactly these."
              },
              "wealth": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "security": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "unrest": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "story": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            },
            "description": "Its backstory in bullets (tools/stories.py)."
          },
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "maxLength": 40,
            "description": "Its system file's id (src/systems/): a flyable layout, loaded on demand (src/data.js). Without one, the system is on the map only."
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "a",
          "b",
          "ly",
          "days"
        ],
        "properties": {
          "a": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999999
          },
          "b": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99999999
          },
          "ly": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "days": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "border": {
            "type": "boolean",
            "default": false,
            "description": "Across a border, out of a faction's territory: a choke point."
          },
          "drift": {
            "type": "boolean",
            "default": false,
            "description": "A Drift lane: the Drift's lanes shift."
          }
        }
      }
    }
  }
}
